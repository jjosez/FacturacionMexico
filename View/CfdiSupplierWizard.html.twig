{#
 * Wizard para importar un CFDI de proveedor y generar su factura.
 #}
{% extends 'Master/MenuBgTemplate.html.twig' %}

{% block bodyHeaderOptions %}
    <div class="container-fluid mb-2">
        <div class="row align-items-center">
            <div class="col">
                <div class="btn-group">
                    <a class="btn btn-sm btn-dark" href="{{ fsc.cfdi.url('wizard') }}" title="Recargar">
                        <i class="fas fa-redo" aria-hidden="true"></i>
                    </a>
                    <a class="btn btn-sm btn-info" href="{{ fsc.cfdi.url() }}" title="Volver al CFDI">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i>&nbsp;CFDI
                    </a>
                </div>
            </div>
            <div class="col text-end">
                <h1 class="h4 mb-0 d-none d-md-inline-block">
                    Importar CFDI de Proveedor
                    <i class="fas fa-file-import fa-fw" aria-hidden="true"></i>
                </h1>
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="container-fluid pb-4 wizard-container">
        <div class="wizard-alerts"></div>
        {% if fsc.importError %}
            <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                <i class="fas fa-circle-exclamation mt-1" aria-hidden="true"></i>
                <div>{{ fsc.importError }}</div>
            </div>
        {% endif %}
        <form id="formCfdiWizard" name="formCfdiWizard" action="{{ fsc.url() }}" method="post">
            <input type="hidden" value="import-supplier-cfdi" name="action">
            <input type="hidden" value="{{ fsc.cfdi.primaryColumnValue() }}" name="code">
            <input type="hidden" value="{{ fsc.cfdi.tipo }}" name="type">

            <ul class="nav nav-pills nav-fill gap-2 mb-4" id="wizardTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active text-start" id="step1-tab" data-bs-toggle="tab"
                            data-bs-target="#step1" type="button" role="tab" aria-controls="step1" aria-selected="true">
                        <span class="badge rounded-pill text-bg-primary me-2">1</span> Generales
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link text-start" id="step2-tab" data-bs-toggle="tab"
                            data-bs-target="#step2" type="button" role="tab" aria-controls="step2" aria-selected="false">
                        <span class="badge rounded-pill text-bg-secondary me-2">2</span> Productos
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link text-start" id="step3-tab" data-bs-toggle="tab"
                            data-bs-target="#step3" type="button" role="tab" aria-controls="step3" aria-selected="false">
                        <span class="badge rounded-pill text-bg-secondary me-2">3</span> Revisión y configuración
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="wizardContent">
                <div class="tab-pane fade show active" id="step1" role="tabpanel" aria-labelledby="step1-tab">
                    {{ include('Block/CfdiSupplierWizard-1.html.twig') }}
                </div>
                <div class="tab-pane fade" id="step2" role="tabpanel" aria-labelledby="step2-tab">
                    {{ include('Block/CfdiSupplierWizard-2.html.twig') }}
                </div>
                <div class="tab-pane fade" id="step3" role="tabpanel" aria-labelledby="step3-tab">
                    {{ include('Block/CfdiSupplierWizard-3.html.twig') }}
                </div>
            </div>

            <div class="border-top pt-3 mt-4 d-flex flex-column flex-sm-row justify-content-between gap-2">
                <button type="button" class="btn btn-outline-secondary" id="prevBtn" data-action="wizard:step:previous">
                    <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Anterior
                </button>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-primary" id="nextBtn" data-action="wizard:step:next">
                        Siguiente <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-success d-none" id="wizardSubmitBtn"
                            data-action="wizard:submit"
                            data-label="Generar factura"
                            data-confirm-message="Se generará la factura del proveedor con la configuración seleccionada.">
                        <i class="fas fa-file-invoice me-1" aria-hidden="true"></i><span data-button-label>Generar factura</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

    {% include 'Modal/CfdiSuppliersModals.html.twig' %}
    <script type="module" src="{{ asset('Plugins/FacturacionMexico/Assets/JS/SupplierCfdiWizard.js') }}"></script>
{% endblock %}
