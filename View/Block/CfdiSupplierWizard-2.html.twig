{% set matchStats = fsc.getMatchStatsArray() %}

<div class="card mb-3">
    <div class="card-header bg-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
            <h2 class="h5 mb-1">Conciliación de productos</h2>
            <p class="text-muted small mb-0">Asocia cada concepto con un producto interno o déjalo como línea libre.</p>
        </div>
        <span class="badge text-bg-{{ matchStats.exactLinked == matchStats.total ? 'success' : 'warning' }}">
            {{ matchStats.exactLinked }} de {{ matchStats.total }} con vínculo de proveedor
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0" id="conceptosTable">
                <thead class="table-light">
                <tr>
                    <th scope="col" class="text-nowrap">#</th>
                    <th scope="col" class="text-nowrap">Concepto del CFDI</th>
                    <th scope="col" class="text-nowrap">Referencia proveedor</th>
                    <th scope="col" class="text-end text-nowrap">Cantidad</th>
                    <th scope="col" class="text-end text-nowrap">Precio unitario</th>
                    <th scope="col" class="text-end text-nowrap">Importe</th>
                    <th scope="col" class="text-nowrap">Producto interno</th>
                    <th scope="col" class="text-nowrap">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
                </thead>
                <tbody>
                {% for concepto in fsc.reader.getConceptos() %}
                    {% set matchResult = fsc.getMatchedConcept(loop.index0) %}
                    {% set isLinked = matchResult and matchResult.isLinked %}
                    {% set matchClass = isLinked ? 'table-success' : '' %}

                    <tr data-index="{{ loop.index0 }}" class="{{ matchClass }}"
                        data-referencia="{{ matchResult.referencia|default('') }}"
                        data-cfdi-reference="{{ concepto.NoIdentificacion|default('') }}"
                        data-concept-description="{{ concepto.Descripcion }}">
                        <td class="text-muted">{{ loop.index }}</td>
                        <td>
                            <div class="fw-semibold">{{ concepto.Descripcion }}</div>
                            <div class="small text-muted">Clave SAT: {{ concepto.ClaveProdServ|default('—') }} · Unidad: {{ concepto.ClaveUnidad|default('—') }}</div>
                        </td>
                        <td>
                            <code class="user-select-all">{{ concepto.NoIdentificacion|default('—') }}</code>
                        </td>
                        <td class="text-end">{{ concepto.Cantidad }}</td>
                        <td class="text-end">{{ concepto.ValorUnitario }}</td>
                        <td class="text-end fw-semibold">{{ concepto.Importe }}</td>
                        <td id="referencia-{{ loop.index0 }}">
                            {% if matchResult and matchResult.referencia %}
                                <span class="fw-semibold">{{ matchResult.referencia }}</span>
                            {% else %}
                                <span class="text-muted">Sin producto</span>
                            {% endif %}
                        </td>
                        <td>
                            <span id="estado-{{ loop.index0 }}" class="badge {{ isLinked ? 'text-bg-success' : 'text-bg-light border text-dark' }}">
                                {{ isLinked ? 'Vinculado' : 'Línea libre' }}
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Acciones del concepto {{ loop.index }}">
                                <button type="button" class="btn btn-outline-primary vincular-btn"
                                        data-action="product:link:open"
                                        data-index="{{ loop.index0 }}"
                                        data-refproveedor="{{ concepto.NoIdentificacion|default('') }}">
                                    Vincular
                                </button>
                                <button type="button" class="btn btn-outline-secondary desvincular-btn"
                                        data-action="product:unlink" data-index="{{ loop.index0 }}">
                                    Quitar
                                </button>
                            </div>
                            {% set newProductUrl = fsc.buildNewProductUrl(concepto.NoIdentificacion|default(''), concepto.Descripcion) %}
                            <a href="{{ newProductUrl }}" class="btn btn-sm btn-outline-warning ms-1" target="_blank"
                               title="Registrar nuevo producto">Registrar</a>
                            <input type="hidden" name="conceptos[{{ loop.index0 }}][referencia]"
                                   id="concepto-referencia-{{ loop.index0 }}"
                                   value="{{ matchResult.referencia|default('') }}">
                        </td>
                    </tr>

                    {% if concepto.Traslados|length > 0 or concepto.Retenciones|length > 0 %}
                        <tr class="table-light">
                            <td></td>
                            <td colspan="2" class="text-muted small">Impuestos del concepto</td>
                            <td colspan="6">
                                {% for traslado in concepto.Traslados %}
                                    <span class="badge text-bg-primary me-1">{{ traslado.Impuesto }} {{ (traslado.TasaOCuota * 100)|round }}%</span>
                                {% endfor %}
                                {% for retencion in concepto.Retenciones %}
                                    <span class="badge text-bg-danger me-1">Ret. {{ retencion.Impuesto }} {{ retencion.Importe }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endif %}

                    <input type="hidden" name="conceptos[{{ loop.index0 }}][cantidad]" value="{{ concepto.Cantidad }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][referencia_proveedor]" value="{{ concepto.NoIdentificacion|default('') }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][descripcion]" value="{{ concepto.Descripcion }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][clavesat]" value="{{ concepto.ClaveProdServ|default('') }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][claveunidad]" value="{{ concepto.ClaveUnidad|default('') }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][valorunitario]" value="{{ concepto.ValorUnitario }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][descuento]" value="{{ concepto.Descuento|default(0) }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][importe]" value="{{ concepto.Importe }}">

                    {% for traslado in concepto.Traslados %}
                        <input type="hidden" name="conceptos[{{ loop.parent.loop.index0 }}][traslados][{{ loop.index0 }}][impuesto]" value="{{ traslado.Impuesto }}">
                        <input type="hidden" name="conceptos[{{ loop.parent.loop.index0 }}][traslados][{{ loop.index0 }}][base]" value="{{ traslado.Base }}">
                        <input type="hidden" name="conceptos[{{ loop.parent.loop.index0 }}][traslados][{{ loop.index0 }}][tasa]" value="{{ traslado.TasaOCuota }}">
                        <input type="hidden" name="conceptos[{{ loop.parent.loop.index0 }}][traslados][{{ loop.index0 }}][importe]" value="{{ traslado.Importe }}">
                    {% endfor %}
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
