{% import 'Macro/Form.html.twig' as form %}

{% set matchStats = fsc.getMatchStatsArray() %}

<div class="card mb-3">
    <div class="card-header bg-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
            <h2 class="h5 mb-1">Conciliación de productos</h2>
            <p class="text-muted small mb-0">Confirma o cambia la sugerencia para cada concepto del CFDI.</p>
        </div>
        <span class="badge text-bg-{{ matchStats.autoMatchRate >= 0.8 ? 'success' : (matchStats.autoMatchRate >= 0.5 ? 'warning' : 'danger') }}">
            {{ matchStats.exactLinked + matchStats.suggestions }} / {{ matchStats.total }} vinculados automáticamente
        </span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="conceptosTable">
                <thead class="table-light">
                <tr>
                    <th>
                        <input type="checkbox" id="selectAllConceptos" title="Seleccionar todos">
                    </th>
                    <th>Cantidad</th>
                    <th>Referencia</th>
                    <th>No. identificación</th>
                    <th>Descripción</th>
                    <th>Clave SAT</th>
                    <th>Precio</th>
                    <th>Total</th>
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                {% for concepto in fsc.reader.getConceptos() %}
                    {% set matchResult = fsc.getMatchedConcept(loop.index0) %}
                    {% set matchClass = '' %}
                    {% set matchBadge = '' %}
                    {% set matchIcon = '' %}

                    {% if matchResult %}
                        {% if matchResult.confidence >= 1.0 %}
                            {% set matchClass = 'table-success' %}
                            {% set matchBadge = 'bg-success' %}
                            {% set matchIcon = 'fa-link' %}
                        {% elseif matchResult.confidence >= 0.85 %}
                            {% set matchClass = 'table-success' %}
                            {% set matchBadge = 'bg-success' %}
                            {% set matchIcon = 'fa-check' %}
                        {% elseif matchResult.confidence >= 0.70 %}
                            {% set matchClass = 'table-warning' %}
                            {% set matchBadge = 'text-bg-warning' %}
                            {% set matchIcon = 'fa-lightbulb' %}
                        {% else %}
                            {% set matchClass = '' %}
                            {% set matchBadge = 'bg-secondary' %}
                            {% set matchIcon = 'fa-question' %}
                        {% endif %}
                    {% endif %}

                    <tr data-index="{{ loop.index0 }}" class="{{ matchClass }}"
                        data-confidence="{{ matchResult.confidence|default(0) }}"
                        data-method="{{ matchResult.matchMethod|default('none') }}"
                        data-referencia="{{ matchResult.referencia|default('') }}"
                        data-cfdi-reference="{{ concepto.NoIdentificacion|default('') }}">

                        <td>
                            <input type="checkbox" class="concepto-checkbox"
                                   name="selected_conceptos[]" value="{{ loop.index0 }}">
                        </td>

                        <td>{{ concepto.Cantidad }}</td>

                        <td id="referencia-{{ loop.index0 }}">
                            {% if matchResult and matchResult.referencia %}
                                <strong>{{ matchResult.referencia }}</strong>
                            {% else %}
                                —
                            {% endif %}
                        </td>

                        <td>{{ concepto.NoIdentificacion|default('—') }}</td>
                        <td>{{ concepto.Descripcion }}</td>
                        <td>
                            <code>{{ concepto.ClaveProdServ|default('—') }}</code>
                        </td>
                        <td>{{ concepto.ValorUnitario }}</td>
                        <td>{{ concepto.Importe }}</td>

                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary vincular-btn"
                                    data-action="product:link:open" data-index="{{ loop.index0 }}">
                                <i class="fas fa-search pe-none"></i>
                            </button>

                            <button type="button" class="btn btn-sm btn-outline-secondary desvincular-btn"
                                    data-action="product:unlink" data-index="{{ loop.index0 }}">
                                <i class="fas fa-unlink pe-none"></i>
                            </button>

                            {% set newProductUrl = fsc.buildNewProductUrl(concepto.NoIdentificacion|default(''), concepto.Descripcion) %}
                            <a href="{{ newProductUrl }}" class="btn btn-sm btn-outline-warning" target="_blank"
                               title="Registrar nuevo producto">
                                <i class="fas fa-plus pe-none"></i>
                            </a>

                            <input type="hidden" name="conceptos[{{ loop.index0 }}][referencia]"
                                   id="concepto-referencia-{{ loop.index0 }}"
                                   value="{{ matchResult.referencia|default('') }}">
                        </td>
                    </tr>

                    {# Impuestos row #}
                    {% if concepto.Traslados|length > 0 or concepto.Retenciones|length > 0 %}
                        <tr class="table-light">
                            <td colspan="2" class="text-end text-muted">
                                <small><i class="fas fa-file-invoice"></i> Impuestos:</small>
                            </td>
                            <td colspan="7">
                                {% for traslado in concepto.Traslados %}
                                    <span class="badge text-bg-primary me-1">
                                        {{ traslado.Impuesto }} {{ (traslado.TasaOCuota * 100)|round }}%
                                    </span>
                                {% endfor %}
                                {% for retencion in concepto.Retenciones %}
                                    <span class="badge text-bg-danger me-1">
                                        Ret. {{ retencion.Impuesto }} {{ (retencion.Importe)}}
                                    </span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endif %}

                    {# Hidden inputs for concepto data #}
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][cantidad]" value="{{ concepto.Cantidad }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][referencia_proveedor]"
                           value="{{ concepto.NoIdentificacion|default('') }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][descripcion]"
                           value="{{ concepto.Descripcion }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][clavesat]"
                           value="{{ concepto.ClaveProdServ|default('') }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][claveunidad]"
                           value="{{ concepto.ClaveUnidad|default('') }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][valorunitario]"
                           value="{{ concepto.ValorUnitario }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][descuento]"
                           value="{{ concepto.Descuento|default(0) }}">
                    <input type="hidden" name="conceptos[{{ loop.index0 }}][importe]"
                           value="{{ concepto.Importe }}">

                    {# Hidden inputs for impuestos #}
                    {% for traslado in concepto.Traslados %}
                        <input type="hidden"
                               name="conceptos[{{ loop.parent.loop.index0 }}][traslados][{{ loop.index0 }}][impuesto]"
                               value="{{ traslado.Impuesto }}">
                        <input type="hidden"
                               name="conceptos[{{ loop.parent.loop.index0 }}][traslados][{{ loop.index0 }}][base]"
                               value="{{ traslado.Base }}">
                        <input type="hidden"
                               name="conceptos[{{ loop.parent.loop.index0 }}][traslados][{{ loop.index0 }}][tasa]"
                               value="{{ traslado.TasaOCuota }}">
                        <input type="hidden"
                               name="conceptos[{{ loop.parent.loop.index0 }}][traslados][{{ loop.index0 }}][importe]"
                               value="{{ traslado.Importe }}">
                    {% endfor %}
                {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Select all checkbox
    const selectAll = document.getElementById('selectAllConceptos');
    if (selectAll) {
        selectAll.addEventListener('change', function() {
            document.querySelectorAll('.concepto-checkbox').forEach(cb => cb.checked = this.checked);
        });
    }

});
</script>
