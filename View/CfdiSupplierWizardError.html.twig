{% extends 'Master/MenuBgTemplate.html.twig' %}

{% block bodyHeaderOptions %}
    <div class="container-fluid mb-2">
        <div class="row align-items-center">
            <div class="col">
                <div class="btn-group">
                    <a class="btn btn-sm btn-dark" href="{{ asset('ListCfdiProveedor') }}" title="CFDI proveedores">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i>&nbsp;CFDI proveedores
                    </a>
                </div>
            </div>
            <div class="col text-end">
                <h1 class="h5 mb-0">
                    Importar CFDI de proveedor
                    <i class="fas fa-file-import fa-fw" aria-hidden="true"></i>
                </h1>
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-6">
                <div class="card border-0 shadow-sm text-center">
                    <div class="card-body p-4 p-md-5">
                        <div class="display-1 text-danger">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                        <h2 class="h4 mb-3">¡Ups! Algo salió mal</h2>
                        <p class="text-muted mb-2">No se pudo cargar el CFDI.</p>
                        <p class="small text-muted mb-4">{{ fsc.wizardError }}</p>
                        <a class="btn btn-primary" href="{{ asset('ListCfdiProveedor') }}">
                            Ver CFDI de proveedores
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
