<div class="modal fade" id="product:link:modal" tabindex="-1" aria-labelledby="product:link:modal:label"
     aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="product:link:modal:label">
                    Vincular producto<span id="product:link:modal:code"></span>
                    <span class="text-muted fw-normal" id="product:link:modal:ref"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <span class="input-group-text" id="productSearchIcon"><i class="fas fa-search" aria-hidden="true"></i></span>
                    <input type="search" id="buscarProductoInput" class="form-control"
                           placeholder="Buscar por referencia, proveedor o descripción"
                           aria-label="Buscar producto">
                    <button type="button" class="btn btn-outline-secondary" id="clearProductSearch" title="Limpiar búsqueda">Limpiar</button>
                </div>
                <div class="small text-muted mb-3">
                    <i class="fas fa-circle-info me-1" aria-hidden="true"></i>
                    Selecciona el producto interno que corresponde a la referencia del CFDI.
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0" id="tablaProductos">
                        <thead>
                        <tr>
                            <th>Referencia</th>
                            <th>Ref. Proveedor</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th>Acción</th>
                        </tr>
                        </thead>
                        <tbody aria-live="polite"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <span class="small text-muted me-auto" id="productSearchStatus"></span>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

{# Templates Eta para renderizado dinámico #}
<script type="text/template" id="product:search:row:template">
    <td><strong><%= it.referencia %></strong></td>
    <td><%= it.refproveedor || it.referencia_fabricante || '—' %></td>
    <td><small><%= it.descripcion %></small></td>
    <td><%= it.pvp ? it.pvp.toLocaleString('es-MX', {style: 'currency', currency: 'MXN'}) : '—' %></td>
    <td>
        <button type="button"
                class="btn btn-sm btn-outline-success"
                data-action="product:select"
                data-referencia="<%= it.referencia %>"
                title="Seleccionar producto">
            Seleccionar
        </button>
    </td>
</script>

<script type="text/template" id="product:search:empty:template">
    <td colspan="5" class="text-center text-muted">
        <%= it.message || 'No se encontraron productos' %>
    </td>
</script>

<script type="text/template" id="product:search:loading:template">
    <td colspan="5" class="text-center">
        <div class="spinner-border spinner-border-sm text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <span class="ms-2"><%= it.message || 'Buscando productos...' %></span>
    </td>
</script>

<script type="text/template" id="product:search:error:template">
    <td colspan="5" class="text-center text-danger">
        <i class="fas fa-exclamation-triangle"></i>
        <span class="ms-2"><%= it.message || 'Error al buscar productos' %></span>
    </td>
</script>

<script type="text/template" id="product:toast:template">
    <div class="toast-header <%= it.bgClass %> text-white">
        <strong class="me-auto"><%= it.title || 'Notificación' %></strong>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
    </div>
    <div class="toast-body">
        <%= it.message %>
    </div>
</script>
