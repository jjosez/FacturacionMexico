<view>
    <columns>
        <column name="supplier" order="110">
            <widget type="select" fieldname="codproveedor" onclick="EditProveedor">
                <values source="proveedores" fieldcode="codproveedor" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="emisor_rfc" title="RFC Emisor" order="120">
            <widget type="text" fieldname="emisor_rfc"/>
        </column>
        <column name="uuid" order="130" title="UUID">
            <widget type="text" fieldname="uuid"/>
        </column>
        <column name="type" display="center" order="140">
            <widget type="text" fieldname="tipo"/>
        </column>
        <column name="amount" display="right" order="150">
            <widget type="money" fieldname="total"/>
        </column>
        <column name="date" display="right" order="160">
            <widget type="date" fieldname="fecha_timbrado"/>
        </column>
    </columns>
    <modals>
        <group name="import-cfdi-file" title="Importar CFDI" icon="fas fa-file-import fa-fw">
            <column name="file" numcolumns="12" order="100">
                <widget type="file" fieldname="cfdifile" accept=".xml"/>
            </column>
        </group>
        <group name="batch_import_modal" title="Importar Lote CFDI" icon="fas fa-file-import fa-fw">
            <column name="batch_options" numcolumns="12" order="100">
                <widget type="text" fieldname="batch_import_info" readonly="true"
                        value="Use el botón de abajo para abrir el asistente de importación masiva"/>
            </column>
        </group>
    </modals>
    <rows>
        <row type="status">
            <option color="" title="Importado" fieldname="estado">imported</option>
            <option color="danger" title="Cancelado" fieldname="estado">cancelled</option>
            <option color="info" title="Conceptos Vinculados" fieldname="estado">linked</option>
            <option color="warning" title="Factura en Borrador" fieldname="estado">draft</option>
            <option color="success" title="Factura Recibida" fieldname="estado">received</option>
            <option color="warning" title="Factura Egreso" fieldname="tipocfdi">E</option>
        </row>
        <row type="actions">
            <button type="modal" icon="fas fa-file-import fa-fw" label="import" color="info"
                    action="import-cfdi-file"/>
            <button type="action" icon="fas fa-upload fa-fw" label="batch-import" color="warning"
                    action="batch-import-cfdi-file" class="batch-import-trigger"/>
        </row>
    </rows>
</view>
