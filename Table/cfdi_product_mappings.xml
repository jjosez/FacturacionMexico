<?xml version="1.0" encoding="UTF-8"?>
<cfdi_product_mappings>
    <name>cfdi_product_mappings</name>
    <version>1.0</version>
    <description>Mapeo de productos CFDI a productos internos</description>

    <columns>
        <column name="id" type="integer" null="NO">
            <constraint>PRIMARY KEY</constraint>
            <constraint>AUTOINCREMENT</constraint>
        </column>
        <column name="codproveedor" type="varchar" length="6" null="NO"/>
        <column name="idempresa" type="integer" null="NO"/>
        <column name="emisor_rfc" type="varchar" length="13" null="NO"/>
        <column name="cfdi_referencia" type="varchar" length="50" null="NO"/>
        <column name="referencia" type="varchar" length="50" null="NO"/>
        <column name="match_method" type="varchar" length="20" null="NO"/>
        <column name="confidence" type="decimal" length="3" scale="2" null="NO" default="0.00"/>
        <column name="created_at" type="datetime" null="NO"/>
        <column name="updated_at" type="datetime" null="NO"/>

        <column name="id_codproveedor" type="reference">
            <references table="proveedores" column="codproveedor"/>
        </column>
        <column name="id_idempresa" type="reference">
            <references table="empresas" column="idempresa"/>
        </column>
    </columns>

    <indexes>
        <index name="idx_cfdi_mapping_supplier">
            <columns>codproveedor</columns>
        </index>
        <index name="idx_cfdi_mapping_company">
            <columns>idempresa</columns>
        </index>
        <index name="idx_cfdi_mapping_reference">
            <columns>cfdi_referencia</columns>
        </index>
        <index name="idx_cfdi_mapping_emisor">
            <columns>emisor_rfc</columns>
        </index>
        <index name="idx_cfdi_mapping_unique">
            <columns>idempresa,emisor_rfc,cfdi_referencia</columns>
            <unique>YES</unique>
        </index>
    </indexes>
</cfdi_product_mappings>
